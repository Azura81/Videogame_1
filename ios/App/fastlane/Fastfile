# Trigger build - rerun 18:04
default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight / App Store Connect"
  lane :release do
    # Select Xcode 26+ for iOS 26 SDK App Store compliance
    xcode_26 = Dir.glob("/Applications/Xcode_26*.app").sort.last
    if xcode_26
      ENV["DEVELOPER_DIR"] = File.join(xcode_26, "Contents/Developer")
      UI.success("Selected Xcode version for build and upload: #{xcode_26}")
    end

    api_key = nil
    team_id = ENV["APPLE_TEAM_ID"] || "4SAM269S3L"

    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] && !ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].empty?
      raw_key = ENV["APP_STORE_CONNECT_API_KEY_KEY"] || ""
      is_base64 = !raw_key.include?("BEGIN PRIVATE KEY")

      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
        key_content: raw_key,
        is_key_content_base64: is_base64,
        in_house: false
      )

      # Create temporary CI keychain for certificates
      create_keychain(
        name: "ci_keychain",
        password: "ci_keychain_password_123",
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )

      # Import distribution certificate and private key into CI keychain
      if ENV["BUILD_CERTIFICATE_BASE64"] && !ENV["BUILD_CERTIFICATE_BASE64"].empty?
        require "base64"
        p12_path = File.expand_path("/tmp/distribution.p12")
        File.open(p12_path, "wb") do |f|
          f.write(Base64.decode64(ENV["BUILD_CERTIFICATE_BASE64"]))
        end
        begin
          import_certificate(
            certificate_path: p12_path,
            certificate_password: ENV["P12_PASSWORD"] || "spiritdelivery123",
            keychain_name: "ci_keychain",
            keychain_password: "ci_keychain_password_123"
          )
          UI.success("Successfully imported distribution certificate and private key into CI keychain!")
        rescue => e
          UI.important("import_certificate note: #{e.message}")
        end
      end

      # Ensure App ID exists in Apple Developer Portal
      begin
        produce(
          api_key: api_key,
          team_id: team_id,
          app_identifier: "com.azura81.spiritdelivery",
          app_name: "Spirit Delivery",
          language: "English"
        )
      rescue => e
        UI.important("Produce note: #{e.message}")
      end

      # Fetch or create distribution certificate
      begin
        get_certificates(
          api_key: api_key,
          team_id: team_id,
          keychain_name: "ci_keychain",
          keychain_password: "ci_keychain_password_123"
        )
      rescue => e
        UI.important("Certificate note: #{e.message}")
      end

      # Fetch or create App Store provisioning profile
      begin
        get_provisioning_profile(
          api_key: api_key,
          team_id: team_id,
          app_identifier: "com.azura81.spiritdelivery"
        )
      rescue => e
        UI.important("Provisioning profile note: #{e.message}")
      end

      # Ensure Xcode project is configured with the team ID
      UI.message("Configuring Xcode project with Team ID: #{team_id}")
      begin
        update_project_team(
          path: "App.xcodeproj",
          teamid: team_id
        )
      rescue => e
        UI.important("update_project_team note: #{e.message}")
      end
    end

    # Automatically detect Xcode workspace or SPM project
    xcode_target = File.exist?("App.xcworkspace") ? { workspace: "App.xcworkspace" } : { project: "App.xcodeproj" }

    profile_name = ENV["SIGH_NAME"] || "com.azura81.spiritdelivery AppStore"
    profile_uuid = ENV["SIGH_UUID"] || ENV["SIGH_UDID"]

    # Configure manual code signing with the downloaded App Store profile
    begin
      update_code_signing_settings(
        path: "App.xcodeproj",
        use_automatic_signing: false,
        team_id: team_id,
        targets: ["App"],
        build_configurations: ["Release"],
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
        profile_uuid: profile_uuid,
        bundle_identifier: "com.azura81.spiritdelivery"
      )
      UI.success("Configured manual code signing with profile: #{profile_name}")
    rescue => e
      UI.important("update_code_signing_settings note: #{e.message}")
    end

    # Build native iOS IPA archive
    build_args = xcode_target.merge({
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "SpiritDelivery.ipa",
      export_team_id: team_id,
      codesigning_identity: "Apple Distribution",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.azura81.spiritdelivery" => profile_name
        }
      }
    })

    build_app(build_args)

    # Upload to TestFlight / App Store Connect if API key is present
    if api_key
      upload_to_testflight(
        api_key: api_key,
        team_id: team_id,
        skip_waiting_for_build_processing: true,
        ipa: "./build/SpiritDelivery.ipa"
      )
    end
  end

  desc "Build IPA for validation"
  lane :build_only do
    xcode_target = File.exist?("App.xcworkspace") ? { workspace: "App.xcworkspace" } : { project: "App.xcodeproj" }
    build_app(
      xcode_target.merge({
        scheme: "App",
        export_method: "app-store",
        clean: true,
        output_directory: "./build",
        output_name: "SpiritDelivery.ipa"
      })
    )
  end
end

